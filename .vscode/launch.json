{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SPC Pro (Debug + Reload)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--reload-dir",
        "app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUNBUFFERED": "1",
        "SPCPRO_DEFAULT_ADMIN_EMAIL": "rodrigo.mocca@spcpro.com",
        "SPCPRO_DEFAULT_ADMIN_PASSWORD": "SpCpRo2026!"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "SPC Pro (Debug)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUNBUFFERED": "1",
        "SPCPRO_DEFAULT_ADMIN_EMAIL": "rodrigo.mocca@spcpro.com",
        "SPCPRO_DEFAULT_ADMIN_PASSWORD": "SpCpRo2026!"
      },
      "jinja": true,
      "justMyCode": true
    }
  ]
}
